{{#> main}}
<div class="page animate-slide-up">
    <div class="browser-header">
        <div class="page-heading">
            <h1 class="page-title">{{t "browser.title"}}</h1>
            <div class="storage-meter">
                <progress class="usage-bar" max="100" value="{{storage.percent}}" aria-label="{{t "browser.storageUsed"}}"></progress>
                <small>{{t "browser.usedOf" used=storage.usedLabel total=storage.totalLabel}}</small>
            </div>
        </div>
        <div class="toolbar">
            <div class="panel sort-controls">
                <label for="sortSelect" class="sort-label">{{t "browser.sortBy"}}</label>
                <select id="sortSelect" class="sort-select">
                    <option value="name">{{t "browser.sortName"}}</option>
                    <option value="date" {{#if_eq sortBy "date"}}selected{{/if_eq}}>{{t "browser.sortDate"}}</option>
                </select>
                <button type="button" data-action="toggle-order"
                    class="btn btn-secondary btn-icon{{#if_eq order "desc"}} is-desc{{/if_eq}}"
                    aria-label="{{#if_eq order "desc"}}{{t "browser.orderDesc"}}{{else}}{{t "browser.orderAsc"}}{{/if_eq}}">
                    <svg class="icon icon-sm order-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M12 5v14M19 12l-7 7-7-7"></path>
                    </svg>
                </button>
            </div>
            {{#if canWrite}}
            <button type="button" data-action="upload" class="btn btn-primary">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="17 8 12 3 7 8"></polyline>
                    <line x1="12" y1="3" x2="12" y2="15"></line>
                </svg>
                {{t "browser.upload"}}
            </button>
            <button type="button" data-action="new-folder" class="btn btn-secondary">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                    <line x1="12" y1="11" x2="12" y2="17"></line>
                    <line x1="9" y1="14" x2="15" y2="14"></line>
                </svg>
                {{t "browser.newFolder"}}
            </button>
            {{/if}}
        </div>
    </div>

    <nav class="panel current-path-bar" aria-label="{{t "browser.breadcrumb"}}">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a class="breadcrumb-link" href="{{homeUrl}}" {{#unless breadcrumbs.length}}aria-current="page"{{/unless}}>
                    <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                    {{t "browser.home"}}
                </a>
            </li>
            {{#each breadcrumbs}}
            <li class="breadcrumb-item">
                <a class="breadcrumb-link" href="{{this.url}}" {{#if @last}}aria-current="page"{{/if}}>{{this.name}}</a>
            </li>
            {{/each}}
        </ol>
    </nav>

    <section id="dropZone" class="drop-zone" aria-label="{{t "browser.files"}}">
        {{#unless files.length}}
        <div class="empty-state">
            <svg class="icon-xl empty-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
            </svg>
            <p>{{t "browser.empty"}}</p>
            {{#if canWrite}}
            <p class="empty-hint">{{t "browser.emptyHint"}}</p>
            {{/if}}
        </div>
        {{/unless}}

        <ul class="file-grid">
            {{#if parentUrl}}
            <li class="file-card parent-card" data-drop-target="parent">
                <a class="file-open" href="{{parentUrl}}">
                    <span class="file-icon">
                        <svg class="icon-xl icon-muted" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                    </span>
                    <span class="file-name">{{t "browser.parentFolder"}}</span>
                </a>
            </li>
            {{/if}}
            {{#each files}}
            <li class="file-card" data-name="{{this.name}}" data-path="{{this.path}}"
                {{#if this.isDirectory}}data-kind="dir"{{else}}data-kind="file"{{#if ../canWrite}} draggable="true"{{/if}}{{/if}}>
                {{#if ../canWrite}}
                <input type="checkbox" class="bulk-checkbox" aria-label="{{t "browser.select" name=this.name}}">
                {{/if}}

                {{#if this.isDirectory}}
                <a class="file-open" href="{{this.openUrl}}" title="{{this.name}}">
                {{else}}
                <button type="button" class="file-open" data-action="open" aria-haspopup="dialog" title="{{this.name}}">
                {{/if}}
                    <span class="file-icon">
                        {{#if this.isDirectory}}
                        <svg class="icon-xl icon-accent" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                        </svg>
                        {{else if this.isImage}}
                        <img src="{{this.thumbnailUrl}}" alt="" class="file-thumbnail" loading="lazy">
                        <svg class="icon-xl icon-muted fallback-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" hidden>
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                            <circle cx="8.5" cy="8.5" r="1.5"></circle>
                            <polyline points="21 15 16 10 5 21"></polyline>
                        </svg>
                        {{else if this.isVideo}}
                        <video class="file-thumbnail" preload="metadata" muted aria-hidden="true">
                            <source src="{{this.downloadUrl}}#t=0.5">
                        </video>
                        {{else}}
                        <svg class="icon-xl icon-muted" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path>
                            <polyline points="13 2 13 9 20 9"></polyline>
                        </svg>
                        {{/if}}
                    </span>
                    <span class="file-name">{{this.name}}</span>
                    {{#unless this.isDirectory}}
                    <span class="file-meta">{{this.sizeLabel}}</span>
                    {{/unless}}
                {{#if this.isDirectory}}
                </a>
                {{else}}
                </button>
                {{/if}}

                {{#if ../canWrite}}
                <div class="file-menu">
                    <button type="button" class="kebab-toggle" data-action="menu" id="menu-button-{{@index}}"
                        aria-haspopup="menu" aria-expanded="false" aria-controls="menu-{{@index}}"
                        aria-label="{{t "browser.actionsFor" name=this.name}}">
                        <svg class="icon icon-filled" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <circle cx="12" cy="12" r="2"></circle>
                            <circle cx="12" cy="5" r="2"></circle>
                            <circle cx="12" cy="19" r="2"></circle>
                        </svg>
                    </button>
                    <div class="dropdown-content" role="menu" id="menu-{{@index}}" aria-labelledby="menu-button-{{@index}}" hidden>
                        <button type="button" role="menuitem" tabindex="-1" class="dropdown-item" data-action="rename">
                            <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M12 20h9"></path>
                                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                            </svg>
                            {{t "browser.rename"}}
                        </button>
                        <button type="button" role="menuitem" tabindex="-1" class="dropdown-item" data-action="move">
                            <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <polyline points="9 18 15 12 9 6"></polyline>
                            </svg>
                            {{t "browser.move"}}
                        </button>
                        <button type="button" role="menuitem" tabindex="-1" class="dropdown-item danger" data-action="delete">
                            <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <polyline points="3 6 5 6 21 6"></polyline>
                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                            </svg>
                            {{t "browser.delete"}}
                        </button>
                    </div>
                </div>
                {{/if}}
            </li>
            {{/each}}
        </ul>

        {{#if pagination.isPaged}}
        <nav class="pagination" aria-label="{{t "browser.pagination"}}">
            {{#if pagination.prevUrl}}
            <a class="btn btn-secondary btn-sm" href="{{pagination.prevUrl}}" rel="prev">{{t "browser.previousPage"}}</a>
            {{/if}}
            <span class="pagination-status">{{t "browser.pageStatus" page=pagination.page pages=pagination.totalPages items=pagination.totalItems}}</span>
            {{#if pagination.nextUrl}}
            <a class="btn btn-secondary btn-sm" href="{{pagination.nextUrl}}" rel="next">{{t "browser.nextPage"}}</a>
            {{/if}}
        </nav>
        {{/if}}
    </section>

    {{#if canWrite}}
    <input type="file" id="fileInput" multiple hidden>
    {{/if}}

    <!-- File preview -->
    <dialog id="previewModal" class="modal modal-preview" aria-labelledby="modalTitle">
        <div class="modal-header">
            <div class="modal-heading">
                <h2 id="modalTitle" class="modal-title"></h2>
                <small id="modalMeta" class="modal-meta"></small>
            </div>
            <div class="modal-actions">
                <a id="modalDownloadLink" href="#" class="btn btn-primary btn-sm" download>
                    <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    {{t "browser.download"}}
                </a>
                <button type="button" class="btn-close" data-action="close-preview" aria-label="{{t "browser.close"}}">&times;</button>
            </div>
        </div>
        <div class="modal-body modal-body-preview" id="modalBody"></div>
        <div id="modalNav" class="modal-nav" hidden>
            <button type="button" data-action="preview-prev" class="modal-nav-btn" aria-label="{{t "browser.previous"}}">&lt;</button>
            <button type="button" data-action="preview-next" class="modal-nav-btn" aria-label="{{t "browser.next"}}">&gt;</button>
        </div>
    </dialog>

    <!-- Prompt / confirm -->
    <dialog id="actionModal" class="modal modal-action" aria-labelledby="actionModalTitle">
        <form method="dialog" id="actionModalForm">
            <div class="modal-header">
                <h2 id="actionModalTitle" class="modal-title"></h2>
                <button type="button" class="btn-close" data-action="close-action-modal" aria-label="{{t "browser.close"}}">&times;</button>
            </div>
            <div class="modal-body modal-body-form">
                <label id="actionModalText" for="actionModalInput" class="modal-text"></label>
                <input type="text" id="actionModalInput" class="prompt-input" hidden>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-action="close-action-modal">{{t "browser.cancel"}}</button>
                <button type="submit" class="btn btn-primary" id="actionModalConfirmBtn">{{t "browser.confirm"}}</button>
            </div>
        </form>
    </dialog>

    <!-- Move picker: browse folders, then "Move here" -->
    <dialog id="moveModal" class="modal modal-move" aria-labelledby="moveModalTitle">
        <div class="modal-header">
            <h2 id="moveModalTitle" class="modal-title" tabindex="-1"></h2>
            <button type="button" class="btn-close" data-action="close-move-modal" aria-label="{{t "browser.close"}}">&times;</button>
        </div>
        <nav class="move-path" aria-label="{{t "browser.breadcrumb"}}">
            <ol id="moveBreadcrumb" class="breadcrumb"></ol>
        </nav>
        <ul id="moveFolderList" class="folder-list" aria-label="{{t "browser.folders"}}"></ul>
        <p id="moveStatus" class="move-status" role="status" aria-live="polite"></p>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-action="close-move-modal">{{t "browser.cancel"}}</button>
            <button type="button" class="btn btn-primary" id="moveHereBtn">{{t "browser.moveHere"}}</button>
        </div>
    </dialog>

    <div id="toastContainer" class="toast-container"></div>

    <!-- Selection -->
    <div id="selectionActionBar" class="selection-action-bar" role="region" aria-label="{{t "browser.selection"}}" hidden>
        <span id="selectionCount" aria-live="polite"></span>
        <div class="selection-actions">
            <button type="button" class="btn btn-sm btn-secondary" data-action="bulk-move">
                <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
                {{t "browser.move"}}
            </button>
            <button type="button" class="btn btn-sm btn-danger" data-action="bulk-delete">
                <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
                {{t "browser.delete"}}
            </button>
            <button type="button" class="btn btn-sm btn-ghost" data-action="clear-selection">{{t "browser.cancel"}}</button>
        </div>
    </div>
</div>

<script type="application/json" id="browserData">{{{clientData}}}</script>
<script src="/js/browser.js"></script>
{{/main}}
