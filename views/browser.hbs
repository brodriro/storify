{{#> main}}
<style>
    /* Inline overrides if needed, mostly moved to style.css */
    @media (max-width: 640px) {
        .file-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.5rem;
        }

        .file-card {
            padding: 0.8rem;
        }

        .file-thumbnail {
            height: 140px;
        }
    }
</style>

<div class="animate-slide-up">

    <!-- Main Content Area -->
    <main>
        <div class="browser-header">
            <h2 style="margin: 0;">File Browser</h2>
            <div class="storage-meter" title="Storage used">
                <progress class="usage-bar" max="100" value="{{storage.percent}}" aria-label="Storage used"></progress>
                <small>{{storage.usedLabel}} of {{storage.totalLabel}}</small>
            </div>
            <div style="display: flex; gap: 1rem;">
                <div class="glass-panel sort-controls">
                    <span class="sort-label">Sort by:</span>
                    <select id="sortSelect" class="sort-select" aria-label="Sort by">
                        <option value="name">Name</option>
                        <option value="date" {{#if_eq sortBy "date"}}selected{{/if_eq}}>Date</option>
                    </select>
                    <button type="button" data-action="toggle-order" class="btn btn-sm btn-secondary icon-btn"
                        id="orderBtn" aria-label="Toggle sort order">
                        <svg class="icon icon-sm" viewBox="0 0 24 24">
                            <path d="M12 5v14M19 12l-7 7-7-7"></path>
                        </svg>
                    </button>
                </div>
                {{#if canWrite}}
                <button type="button" data-action="upload" class="btn btn-primary icon-btn">
                    <svg class="icon" viewBox="0 0 24 24">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="17 8 12 3 7 8"></polyline>
                        <line x1="12" y1="3" x2="12" y2="15"></line>
                    </svg>
                    Upload
                </button>
                <button type="button" data-action="new-folder" class="btn btn-secondary icon-btn">
                    <svg class="icon" viewBox="0 0 24 24">
                        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                        <line x1="12" y1="11" x2="12" y2="17"></line>
                        <line x1="9" y1="14" x2="15" y2="14"></line>
                    </svg>
                    New Folder
                </button>
                {{/if}}
            </div>
        </div>

        <div class="glass-panel current-path-bar">
            <div class="breadcrumb">
                <div class="breadcrumb-item">
                    <span class="breadcrumb-link" data-action="go" data-path="">
                        <svg class="icon icon-sm" viewBox="0 0 24 24" style="margin-right: 2px;">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                        </svg> Home
                    </span>
                </div>
                {{#each breadcrumbs}}
                <span class="breadcrumb-separator">/</span>
                <div class="breadcrumb-item">
                    <span class="breadcrumb-link" data-action="go" data-path="{{this.path}}">{{this.name}}</span>
                </div>
                {{/each}}
            </div>
        </div>

        <!-- Drag & Drop Zone -->
        <div id="dropZone" class="drop-zone" style="min-height: 50vh;">

            {{#unless files.length}}
            <div class="empty-state">
                <div class="empty-icon">
                    <svg class="icon-lg" style="opacity: 0.3;" viewBox="0 0 24 24">
                        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                    </svg>
                </div>
                <p>This folder is empty.</p>
                {{#if canWrite}}
                <p style="font-size: 0.9rem;">Drag and drop files here to upload.</p>
                {{/if}}
            </div>
            {{/unless}}

            <ul class="file-grid">
                {{#if canWrite}}
                {{#if currentPath}}
                {{#if files.length}}
                <li class="glass-panel file-card parent-drop-card" data-drop-target="parent">
                    <div class="file-icon">
                        <svg class="icon-lg" style="color: var(--text-muted);" viewBox="0 0 24 24">
                            <circle cx="6" cy="12" r="1.8"></circle>
                            <circle cx="12" cy="12" r="1.8"></circle>
                            <circle cx="18" cy="12" r="1.8"></circle>
                        </svg>
                    </div>
                    <div class="file-name" style="text-align: center;">Move to parent folder</div>
                </li>
                {{/if}}
                {{/if}}
                {{/if}}
                {{#each files}}
                <li class="glass-panel file-card" data-name="{{this.name}}" data-path="{{this.path}}"
                    {{#if this.isDirectory}}data-kind="dir" style="cursor: pointer;"
                    {{else}}data-kind="file"{{#if ../canWrite}} draggable="true"{{/if}}{{/if}}>

                    {{#if ../canWrite}}
                    <!-- Bulk selection checkbox -->
                    <input type="checkbox" class="bulk-checkbox" aria-label="Select {{this.name}}">
                    {{/if}}

                    <div class="file-icon">
                        {{#if this.isDirectory}}
                        <svg class="icon-lg" style="color: var(--color-cta);" viewBox="0 0 24 24">
                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z">
                            </path>
                        </svg>
                        {{else if this.isImage}}
                        <img src="{{this.thumbnailUrl}}" alt="{{this.name}}" class="file-thumbnail" loading="lazy">
                        <svg class="icon-lg fallback-icon" style="color: var(--text-muted); display: none;"
                            viewBox="0 0 24 24">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                            <circle cx="8.5" cy="8.5" r="1.5"></circle>
                            <polyline points="21 15 16 10 5 21"></polyline>
                        </svg>
                        {{else if this.isVideo}}
                        <video class="file-thumbnail" preload="metadata" muted>
                            <source src="{{this.downloadUrl}}#t=0.5">
                        </video>
                        {{else}}
                        <svg class="icon-lg" style="color: var(--text-muted);" viewBox="0 0 24 24">
                            <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path>
                            <polyline points="13 2 13 9 20 9"></polyline>
                        </svg>
                        {{/if}}
                    </div>
                    <div class="file-name">{{this.name}}</div>

                    {{#unless this.isDirectory}}
                    <div class="file-meta">{{this.sizeLabel}}</div>
                    {{/unless}}

                    {{#if ../canWrite}}
                    <!-- Kebab Menu Toggle -->
                    <button type="button" class="btn btn-sm file-action-btn kebab-toggle" data-action="menu"
                        aria-label="Actions for {{this.name}}"
                        style="position: absolute; top: 10px; right: 10px; z-index: 10; padding: 4px; background: rgba(0,0,0,0.5); border: none; color: white; border-radius: 4px;">
                        <svg class="icon" viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="2"></circle>
                            <circle cx="12" cy="5" r="2"></circle>
                            <circle cx="12" cy="19" r="2"></circle>
                        </svg>
                    </button>

                    <!-- Dropdown Menu -->
                    <div class="dropdown-content">
                        <div class="dropdown-item" data-action="rename">
                            <svg class="icon icon-sm" viewBox="0 0 24 24">
                                <path d="M12 20h9"></path>
                                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                            </svg> Rename
                        </div>
                        <div class="dropdown-item" data-action="move">
                            <svg class="icon icon-sm" viewBox="0 0 24 24">
                                <polyline points="9 18 15 12 9 6"></polyline>
                            </svg> Move
                        </div>
                        <div class="dropdown-item danger" data-action="delete">
                            <svg class="icon icon-sm" viewBox="0 0 24 24">
                                <polyline points="3 6 5 6 21 6"></polyline>
                                <path
                                    d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                                </path>
                            </svg> Delete
                        </div>
                    </div>
                    {{/if}}

                    <div class="file-actions">
                        {{#if this.isDirectory}}
                        <button type="button" data-action="open" class="btn btn-sm file-action-eye"
                            title="Open folder">
                            <svg class="icon icon-sm" viewBox="0 0 24 24">
                                <path d="M3 7h5l2 3h11v9a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2z"></path>
                                <polyline points="9 14 12 17 15 14"></polyline>
                            </svg>
                        </button>
                        {{else}}
                        <button type="button" data-action="open" class="btn btn-sm file-action-eye"
                            title="View full">
                            <svg class="icon icon-sm" viewBox="0 0 24 24">
                                <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </button>
                        {{/if}}
                    </div>
                </li>
                {{/each}}
            </ul>

            {{#if pagination.isPaged}}
            <nav class="pagination" aria-label="Paginación">
                {{#if pagination.prevUrl}}
                <a class="btn btn-secondary btn-sm" href="{{pagination.prevUrl}}" rel="prev">Anterior</a>
                {{/if}}
                <span class="pagination-status">Página {{pagination.page}} de {{pagination.totalPages}} · {{pagination.totalItems}} elementos</span>
                {{#if pagination.nextUrl}}
                <a class="btn btn-secondary btn-sm" href="{{pagination.nextUrl}}" rel="next">Siguiente</a>
                {{/if}}
            </nav>
            {{/if}}
        </div>
    </main>

    {{#if canWrite}}
    <input type="file" id="fileInput" multiple style="display: none;">
    {{/if}}

    <!-- Advanced Preview Modal (Lightbox) -->
    <div id="previewModal" class="modal-overlay" data-action="close-preview">
        <div class="modal-content">
            <div class="modal-header">
                <div style="display: flex; flex-direction: column;">
                    <h3 id="modalTitle"
                        style="margin: 0; font-family: 'Fira Code', monospace; color: var(--color-cta);">filename.ext
                    </h3>
                    <small id="modalMeta" style="color: var(--text-muted); font-size: 0.8rem;">0.0 MB</small>
                </div>
                <div style="display: flex; gap: 0.5rem; align-items: center;">
                    <a id="modalDownloadLink" href="#" class="btn btn-primary icon-btn" download
                        style="padding: 6px 12px; font-size: 0.8rem;">
                        <svg class="icon icon-sm" viewBox="0 0 24 24">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                        Download
                    </a>
                    <button type="button" class="btn-close" data-action="close-preview" aria-label="Close"
                        style="font-size: 2rem;">&times;</button>
                </div>
            </div>
            <div class="modal-body" id="modalBody"
                style="background: repeating-conic-gradient(#1e293b 0% 25%, transparent 0% 50%) 50% / 20px 20px;">
                <!-- Content injected here -->
            </div>
            <!-- Navigation Controls (Visible only when relevant) -->
            <div id="modalNav"
                style="display: none; justify-content: space-between; position: absolute; top: 50%; width: 100%; padding: 0 1rem; transform: translateY(-50%); pointer-events: none;">
                <button type="button" data-action="preview-prev" class="btn btn-secondary" aria-label="Previous"
                    style="pointer-events: auto; border-radius: 50%; width: 48px; height: 48px; background: rgba(0,0,0,0.5); border: none; color: white;">&lt;</button>
                <button type="button" data-action="preview-next" class="btn btn-secondary" aria-label="Next"
                    style="pointer-events: auto; border-radius: 50%; width: 48px; height: 48px; background: rgba(0,0,0,0.5); border: none; color: white;">&gt;</button>
            </div>
        </div>
    </div>

    <!-- Toast Notification Container -->
    <div id="toastContainer" class="toast-container"></div>

    <!-- Custom Prompt/Confirm Modal -->
    <div id="actionModal" class="modal-overlay" data-action="close-action-modal">
        <div class="modal-content" style="max-width: 400px; padding: 1.5rem;">
            <div class="modal-header">
                <h3 id="actionModalTitle" style="margin: 0; color: var(--color-cta);">Action</h3>
                <button type="button" class="btn-close" data-action="close-action-modal" aria-label="Close"
                    style="font-size: 1.5rem;">&times;</button>
            </div>
            <div class="modal-body"
                style="min-height: auto; align-items: flex-start; justify-content: flex-start; flex-direction: column;">
                <p id="actionModalText" style="margin: 0 0 1rem 0; color: var(--text-main);">Please confirm.</p>
                <input type="text" id="actionModalInput" class="prompt-input" style="display: none;">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-action="close-action-modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="actionModalConfirmBtn">Confirm</button>
            </div>
        </div>
    </div>

    <!-- Selection Action Bar -->
    <div id="selectionActionBar" class="selection-action-bar" style="display: none;">
        <span id="selectionCount">0 selected</span>
        <div class="selection-actions">
            <button type="button" class="btn btn-sm" data-action="bulk-move">
                <svg class="icon icon-sm" viewBox="0 0 24 24">
                    <polyline points="9 18 15 12 9 6"></polyline>
                </svg> Move
            </button>
            <button type="button" class="btn btn-sm danger" data-action="bulk-delete">
                <svg class="icon icon-sm" viewBox="0 0 24 24">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg> Delete
            </button>
            <button type="button" class="btn btn-sm" data-action="clear-selection"
                style="background: transparent; border: 1px solid rgba(255,255,255,0.2);">Cancel</button>
        </div>
    </div>

</div>

<script type="application/json" id="browserData">{{{clientData}}}</script>
<script src="/js/browser.js"></script>
{{/main}}
