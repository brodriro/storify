{{#> main}}
<div class="page">
    <header class="page-header">
        <div class="page-heading">
            <nav class="breadcrumb-nav" aria-label="{{t "browser.breadcrumb"}}">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a class="breadcrumb-link" href="{{homeUrl}}" {{#unless breadcrumbs.length}}aria-current="page"{{/unless}}>
                            <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                <polyline points="9 22 9 12 15 12 15 22"></polyline>
                            </svg>
                            {{t "browser.home"}}
                        </a>
                    </li>
                    {{#each breadcrumbs}}
                    <li class="breadcrumb-item">
                        <a class="breadcrumb-link" href="{{this.url}}" {{#if @last}}aria-current="page"{{/if}}>{{this.name}}</a>
                    </li>
                    {{/each}}
                </ol>
            </nav>
            <h1 class="page-title">{{folderName}}</h1>
        </div>

        <div class="storage-meter meter-{{storage.level}}">
            <div class="meter-label">
                <span>{{t "browser.storageUsed"}}</span>
                <span class="meter-value">{{storage.percent}} %</span>
            </div>
            <progress class="usage-bar" max="100" value="{{storage.percent}}" aria-label="{{t "browser.storageUsed"}}"></progress>
            <small class="meter-detail">{{t "browser.usedOfFree" used=storage.usedLabel total=storage.totalLabel free=storage.freeLabel}}</small>
        </div>
    </header>

    <div class="toolbar">
        {{#if canWrite}}
        <div class="toolbar-group">
            <button type="button" data-action="upload" class="btn btn-primary">
                <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="17 8 12 3 7 8"></polyline>
                    <line x1="12" y1="3" x2="12" y2="15"></line>
                </svg>
                {{t "browser.upload"}}
            </button>
            <button type="button" data-action="new-folder" class="btn btn-secondary">
                <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                    <line x1="12" y1="11" x2="12" y2="17"></line>
                    <line x1="9" y1="14" x2="15" y2="14"></line>
                </svg>
                {{t "browser.newFolder"}}
            </button>
            <div id="uploadStatus" class="upload-status" hidden>
                <span id="uploadText" class="upload-text" role="status"></span>
                <progress id="uploadBar" class="usage-bar upload-bar" max="100" value="0" aria-labelledby="uploadText"></progress>
            </div>
        </div>
        {{/if}}

        <div class="toolbar-group toolbar-end">
            {{#if isGrid}}
            <div class="sort-controls">
                <label for="sortSelect" class="sort-label">{{t "browser.sortBy"}}</label>
                <select id="sortSelect" class="sort-select">
                    <option value="name">{{t "browser.sortName"}}</option>
                    <option value="date" {{#if_eq sortBy "date"}}selected{{/if_eq}}>{{t "browser.sortDate"}}</option>
                    <option value="size" {{#if_eq sortBy "size"}}selected{{/if_eq}}>{{t "browser.sortSize"}}</option>
                </select>
                <button type="button" data-action="toggle-order"
                    class="btn btn-secondary btn-icon{{#if_eq order "desc"}} is-desc{{/if_eq}}"
                    aria-label="{{#if_eq order "desc"}}{{t "browser.orderDesc"}}{{else}}{{t "browser.orderAsc"}}{{/if_eq}}">
                    <svg class="icon icon-sm order-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M12 5v14M19 12l-7 7-7-7"></path>
                    </svg>
                </button>
            </div>
            {{/if}}
            <div class="segmented" role="group" aria-label="{{t "browser.view"}}">
                <a class="segmented-item" href="{{viewListUrl}}" {{#unless isGrid}}aria-current="true"{{/unless}}>
                    <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <line x1="8" y1="6" x2="21" y2="6"></line>
                        <line x1="8" y1="12" x2="21" y2="12"></line>
                        <line x1="8" y1="18" x2="21" y2="18"></line>
                        <line x1="3" y1="6" x2="3.01" y2="6"></line>
                        <line x1="3" y1="12" x2="3.01" y2="12"></line>
                        <line x1="3" y1="18" x2="3.01" y2="18"></line>
                    </svg>
                    <span class="segmented-label">{{t "browser.viewList"}}</span>
                </a>
                <a class="segmented-item" href="{{viewGridUrl}}" {{#if isGrid}}aria-current="true"{{/if}}>
                    <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <rect x="3" y="3" width="7" height="7"></rect>
                        <rect x="14" y="3" width="7" height="7"></rect>
                        <rect x="14" y="14" width="7" height="7"></rect>
                        <rect x="3" y="14" width="7" height="7"></rect>
                    </svg>
                    <span class="segmented-label">{{t "browser.viewGrid"}}</span>
                </a>
            </div>
        </div>
    </div>

    <section id="dropZone" class="drop-zone{{#if isGrid}} is-grid{{/if}}" aria-label="{{t "browser.files"}}">
        {{#if isGrid}}
        <ul class="file-grid">
            {{#if parentUrl}}
            <li class="file-item file-card parent-card" data-drop-target="parent">
                <a class="file-open" href="{{parentUrl}}">
                    <span class="file-icon">
                        <svg class="icon-xl icon-muted" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                    </span>
                    <span class="file-name">{{t "browser.parentFolder"}}</span>
                </a>
            </li>
            {{/if}}
            {{#each files}}
            <li class="file-item file-card" data-name="{{this.name}}" data-path="{{this.path}}"
                {{#if this.isDirectory}}data-kind="dir"{{else}}data-kind="file"{{#if ../canWrite}} draggable="true"{{/if}}{{/if}}>
                {{#if ../canWrite}}
                <input type="checkbox" class="bulk-checkbox" aria-label="{{t "browser.select" name=this.name}}">
                {{/if}}

                {{#if this.isDirectory}}
                <a class="file-open" href="{{this.openUrl}}" title="{{this.name}}">
                {{else}}
                <button type="button" class="file-open" data-action="open" aria-haspopup="dialog" title="{{this.name}}">
                {{/if}}
                    <span class="file-icon">
                        {{#if this.isDirectory}}
                        <svg class="icon-xl icon-folder" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                        </svg>
                        {{else if this.isImage}}
                        <img src="{{this.thumbnailUrl}}" alt="" class="file-thumbnail" loading="lazy">
                        <svg class="icon-xl icon-muted fallback-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" hidden>
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                            <circle cx="8.5" cy="8.5" r="1.5"></circle>
                            <polyline points="21 15 16 10 5 21"></polyline>
                        </svg>
                        {{else if this.isVideo}}
                        <video class="file-thumbnail" preload="metadata" muted aria-hidden="true">
                            <source src="{{this.downloadUrl}}#t=0.5">
                        </video>
                        {{else}}
                        <svg class="icon-xl icon-muted" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path>
                            <polyline points="13 2 13 9 20 9"></polyline>
                        </svg>
                        <span class="file-ext">{{this.typeCode}}</span>
                        {{/if}}
                    </span>
                    <span class="file-name">{{this.name}}</span>
                    <span class="file-meta">{{#if this.isDirectory}}{{t "browser.folder"}}{{else}}{{this.sizeLabel}}{{/if}}</span>
                {{#if this.isDirectory}}
                </a>
                {{else}}
                </button>
                {{/if}}

                {{#if ../canWrite}}{{> fileMenu index=@index}}{{/if}}
            </li>
            {{/each}}
        </ul>
        {{#if files.length}}
        <p class="file-summary">{{t "browser.summary" folders=summary.folders files=summary.files size=summary.sizeLabel}}</p>
        {{/if}}
        {{else}}
        <table class="file-table">
            <thead>
                <tr>
                    {{#if canWrite}}
                    <th scope="col" class="col-select">
                        <input type="checkbox" class="select-all" aria-label="{{t "browser.selectAll"}}" {{#unless files.length}}disabled{{/unless}}>
                    </th>
                    {{/if}}
                    {{#each columns}}
                    <th scope="col" class="col-{{this.key}}" aria-sort="{{this.ariaSort}}">
                        <a class="sort-link{{#if this.isActive}} is-active{{/if}}{{#if this.isDesc}} is-desc{{/if}}" href="{{this.url}}">
                            {{#if_eq this.key "name"}}{{t "browser.colName"}}{{/if_eq}}{{#if_eq this.key "size"}}{{t "browser.colSize"}}{{/if_eq}}{{#if_eq this.key "date"}}{{t "browser.colModified"}}{{/if_eq}}
                            <svg class="icon icon-sm sort-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <polyline points="6 15 12 9 18 15"></polyline>
                            </svg>
                        </a>
                    </th>
                    {{/each}}
                    <th scope="col" class="col-type">{{t "browser.colType"}}</th>
                    <th scope="col" class="col-actions"><span class="visually-hidden">{{t "browser.colActions"}}</span></th>
                </tr>
            </thead>
            <tbody>
                {{#if parentUrl}}
                <tr class="file-item file-row parent-row" data-drop-target="parent">
                    {{#if canWrite}}<td class="col-select"></td>{{/if}}
                    <td class="col-name">
                        <a class="file-open" href="{{parentUrl}}">
                            <span class="file-thumb">
                                <svg class="icon icon-muted" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <polyline points="9 14 4 9 9 4"></polyline>
                                    <path d="M20 20v-7a4 4 0 0 0-4-4H4"></path>
                                </svg>
                            </span>
                            <span class="file-name">{{t "browser.parentFolder"}}</span>
                        </a>
                    </td>
                    <td class="col-size"></td>
                    <td class="col-date"></td>
                    <td class="col-type"></td>
                    <td class="col-actions"></td>
                </tr>
                {{/if}}
                {{#each files}}
                <tr class="file-item file-row" data-name="{{this.name}}" data-path="{{this.path}}"
                    {{#if this.isDirectory}}data-kind="dir"{{else}}data-kind="file"{{#if ../canWrite}} draggable="true"{{/if}}{{/if}}>
                    {{#if ../canWrite}}
                    <td class="col-select">
                        <input type="checkbox" class="bulk-checkbox" aria-label="{{t "browser.select" name=this.name}}">
                    </td>
                    {{/if}}
                    <td class="col-name">
                        {{#if this.isDirectory}}
                        <a class="file-open" href="{{this.openUrl}}">
                        {{else}}
                        <button type="button" class="file-open" data-action="open" aria-haspopup="dialog">
                        {{/if}}
                            <span class="file-thumb">
                                {{#if this.isDirectory}}
                                <svg class="icon icon-folder" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                                </svg>
                                {{else if this.isImage}}
                                <img src="{{this.thumbnailUrl}}" alt="" class="file-thumbnail" loading="lazy">
                                <svg class="icon icon-muted fallback-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" hidden>
                                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                    <polyline points="21 15 16 10 5 21"></polyline>
                                </svg>
                                {{else if this.isVideo}}
                                <svg class="icon icon-muted" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <polygon points="23 7 16 12 23 17 23 7"></polygon>
                                    <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                                </svg>
                                {{else}}
                                <svg class="icon icon-muted" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path>
                                    <polyline points="13 2 13 9 20 9"></polyline>
                                </svg>
                                {{/if}}
                            </span>
                            <span class="file-text">
                                <span class="file-name">{{this.name}}</span>
                                <span class="file-sub">{{#unless this.isDirectory}}{{this.sizeLabel}} · {{/unless}}{{this.modifiedLabel}}</span>
                            </span>
                        {{#if this.isDirectory}}
                        </a>
                        {{else}}
                        </button>
                        {{/if}}
                    </td>
                    <td class="col-size">{{#if this.isDirectory}}<span class="text-muted">—</span>{{else}}<span title="{{t "browser.bytes" bytes=this.sizeBytesLabel}}">{{this.sizeLabel}}</span>{{/if}}</td>
                    <td class="col-date"><time datetime="{{this.modifiedIso}}">{{this.modifiedLabel}}</time></td>
                    <td class="col-type">{{#if this.isDirectory}}{{t "browser.folder"}}{{else}}<span class="type-tag">{{this.typeCode}}</span>{{/if}}</td>
                    <td class="col-actions">{{#if ../canWrite}}{{> fileMenu index=@index}}{{/if}}</td>
                </tr>
                {{/each}}
            </tbody>
            {{#if files.length}}
            <tfoot>
                <tr>
                    <td colspan="{{#if canWrite}}6{{else}}5{{/if}}">{{t "browser.summary" folders=summary.folders files=summary.files size=summary.sizeLabel}}</td>
                </tr>
            </tfoot>
            {{/if}}
        </table>
        {{/if}}

        {{#unless files.length}}
        <div class="empty-state">
            <svg class="icon-xl empty-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
            </svg>
            <p class="empty-title">{{t "browser.empty"}}</p>
            {{#if canWrite}}
            <p class="empty-hint">{{t "browser.emptyHint"}}</p>
            {{/if}}
        </div>
        {{/unless}}

        {{#if pagination.isPaged}}
        <nav class="pagination" aria-label="{{t "browser.pagination"}}">
            {{#if pagination.prevUrl}}
            <a class="btn btn-secondary btn-sm" href="{{pagination.prevUrl}}" rel="prev">{{t "browser.previousPage"}}</a>
            {{/if}}
            <span class="pagination-status">{{t "browser.pageStatus" page=pagination.page pages=pagination.totalPages items=pagination.totalItems}}</span>
            {{#if pagination.nextUrl}}
            <a class="btn btn-secondary btn-sm" href="{{pagination.nextUrl}}" rel="next">{{t "browser.nextPage"}}</a>
            {{/if}}
        </nav>
        {{/if}}
    </section>

    {{#if canWrite}}
    <input type="file" id="fileInput" multiple hidden>
    {{/if}}

    <!-- File preview -->
    <dialog id="previewModal" class="modal modal-preview" aria-labelledby="modalTitle">
        <div class="modal-header">
            <div class="modal-heading">
                <h2 id="modalTitle" class="modal-title"></h2>
                <small id="modalMeta" class="modal-meta"></small>
            </div>
            <div class="modal-actions">
                <a id="modalDownloadLink" href="#" class="btn btn-primary btn-sm" download>
                    <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    {{t "browser.download"}}
                </a>
                <button type="button" class="btn-close" data-action="close-preview" aria-label="{{t "browser.close"}}">&times;</button>
            </div>
        </div>
        <div class="modal-body modal-body-preview" id="modalBody"></div>
        <div id="modalNav" class="modal-nav" hidden>
            <button type="button" data-action="preview-prev" class="modal-nav-btn" aria-label="{{t "browser.previous"}}">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <button type="button" data-action="preview-next" class="modal-nav-btn" aria-label="{{t "browser.next"}}">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
        </div>
    </dialog>

    <!-- Prompt / confirm -->
    <dialog id="actionModal" class="modal modal-action" aria-labelledby="actionModalTitle">
        <form method="dialog" id="actionModalForm">
            <div class="modal-header">
                <h2 id="actionModalTitle" class="modal-title"></h2>
                <button type="button" class="btn-close" data-action="close-action-modal" aria-label="{{t "browser.close"}}">&times;</button>
            </div>
            <div class="modal-body modal-body-form">
                <label id="actionModalText" for="actionModalInput" class="modal-text"></label>
                <input type="text" id="actionModalInput" class="prompt-input" hidden>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-action="close-action-modal">{{t "browser.cancel"}}</button>
                <button type="submit" class="btn btn-primary" id="actionModalConfirmBtn">{{t "browser.confirm"}}</button>
            </div>
        </form>
    </dialog>

    <!-- Move picker: browse folders, then "Move here" -->
    <dialog id="moveModal" class="modal modal-move" aria-labelledby="moveModalTitle">
        <div class="modal-header">
            <h2 id="moveModalTitle" class="modal-title" tabindex="-1"></h2>
            <button type="button" class="btn-close" data-action="close-move-modal" aria-label="{{t "browser.close"}}">&times;</button>
        </div>
        <nav class="move-path" aria-label="{{t "browser.breadcrumb"}}">
            <ol id="moveBreadcrumb" class="breadcrumb"></ol>
        </nav>
        <ul id="moveFolderList" class="folder-list" aria-label="{{t "browser.folders"}}"></ul>
        <div class="modal-footer">
            <p id="moveStatus" class="move-status" role="status" aria-live="polite"></p>
            <button type="button" class="btn btn-secondary" data-action="close-move-modal">{{t "browser.cancel"}}</button>
            <button type="button" class="btn btn-primary" id="moveHereBtn">{{t "browser.moveHere"}}</button>
        </div>
    </dialog>

    <div id="toastContainer" class="toast-container"></div>

    <!-- Selection -->
    <div id="selectionActionBar" class="selection-action-bar" role="region" aria-label="{{t "browser.selection"}}" hidden>
        <span id="selectionCount" class="selection-count" aria-live="polite"></span>
        <div class="selection-actions">
            <button type="button" class="btn btn-sm btn-secondary" data-action="bulk-move">
                <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <polyline points="5 9 2 12 5 15"></polyline>
                    <polyline points="9 5 12 2 15 5"></polyline>
                    <polyline points="15 19 12 22 9 19"></polyline>
                    <polyline points="19 9 22 12 19 15"></polyline>
                    <line x1="2" y1="12" x2="22" y2="12"></line>
                    <line x1="12" y1="2" x2="12" y2="22"></line>
                </svg>
                {{t "browser.move"}}
            </button>
            <button type="button" class="btn btn-sm btn-danger" data-action="bulk-delete">
                <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
                {{t "browser.delete"}}
            </button>
            <button type="button" class="btn btn-sm btn-ghost" data-action="clear-selection">{{t "browser.cancel"}}</button>
        </div>
    </div>
</div>

<script type="application/json" id="browserData">{{{clientData}}}</script>
<script src="/js/browser.js"></script>
{{/main}}
