<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <title>{{#if pageTitle}}{{pageTitle}} · {{/if}}{{t "app.name"}}</title>
    <!-- Sets html[data-theme] before the page paints -->
    <script src="/js/theme.js"></script>
    <!-- UI strings for public/js (src/i18n), inert JSON read by i18n.js -->
    <script type="application/json" id="i18n">{{clientMessages}}</script>
    <script src="/js/i18n.js"></script>
    <link rel="stylesheet" href="/css/fonts.css">
    <link rel="stylesheet" href="/css/tokens.css">
    <link rel="stylesheet" href="/css/style.css">
    {{#if user}}<link rel="stylesheet" href="/css/chat.css">{{/if}}
</head>

<body>
    <a class="skip-link" href="#main">{{t "app.skipToContent"}}</a>

    {{#if user}}
    <div class="app-shell">
        {{> sidebar}}
        <main id="main" class="main-content">
        {{> @partial-block }}
        </main>
    </div>

    <button type="button" id="chat-button" class="chat-button" aria-label="{{t "chat.open"}}"
        aria-expanded="false" aria-controls="chat-sidebar">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
    </button>

    <aside id="chat-sidebar" class="chat-sidebar" aria-label="{{t "chat.assistant"}}" inert>
        <div class="chat-header">
            <div class="chat-header-info">
                <div class="chat-header-icon">
                    <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M12 2a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2 2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"></path>
                        <path d="M5 10h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2z"></path>
                        <path d="M9 14v4"></path>
                        <path d="M15 14v4"></path>
                    </svg>
                </div>
                <div>
                    <h2 class="chat-title">{{t "chat.title"}}</h2>
                    <p>{{t "chat.subtitle"}}</p>
                </div>
            </div>
            <button type="button" id="close-chat" aria-label="{{t "chat.close"}}">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <div class="chat-history" id="chat-history" role="log" aria-live="polite" aria-label="{{t "chat.conversation"}}"></div>

        <div class="typing-indicator-wrapper" id="typing-indicator" aria-hidden="true">
            <div class="typing-dots">
                <span></span><span></span><span></span>
            </div>
        </div>

        <div class="chat-input-container">
            <div class="chat-input-wrapper">
                <textarea id="chat-message-input" aria-label="{{t "chat.message"}}" placeholder="{{t "chat.placeholder"}}" rows="1"></textarea>
            </div>
            <button type="button" id="send-chat-message" class="btn-send-chat" disabled aria-label="{{t "chat.send"}}">
                <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <line x1="22" y1="2" x2="11" y2="13"></line>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
            </button>
        </div>
    </aside>
    {{else}}
    {{> header}}
    <main id="main" class="main-content main-content-single">
    {{> @partial-block }}
    </main>
    {{/if}}

    {{#if user}}
    <!-- Served by the Socket.IO server itself, so the version always matches -->
    <script src="/socket.io/socket.io.min.js"></script>
    <script src="/vendor/marked/marked.umd.js"></script>
    <script src="/vendor/dompurify/purify.min.js"></script>
    <script src="/js/chat.js"></script>
    {{/if}}
</body>

</html>
