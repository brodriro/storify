{{#> main}}
<div class="page animate-slide-up">
    <div class="page-header">
        <h1 class="page-title">Admin Dashboard</h1>
        <a href="/files/browser" class="btn btn-secondary">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <polyline points="15 18 9 12 15 6"></polyline>
                <line x1="9" y1="12" x2="21" y2="12"></line>
            </svg>
            Volver al navegador
        </a>
    </div>

    <div class="stats-grid">
        <section class="panel stat-card" aria-labelledby="usage-title">
            <h2 id="usage-title" class="stat-title">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path
                        d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z">
                    </path>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                    <line x1="12" y1="22.08" x2="12" y2="12"></line>
                </svg>
                Storage Usage
            </h2>
            <p class="usage-files-count">
                {{stats.totalFiles}} <span class="usage-files-label">files</span>
            </p>
            <div class="usage-meta">
                <span>Total Size</span>
                <strong>{{totalSizeMb}} MB</strong>
            </div>
            <progress class="usage-bar" max="100" value="{{usagePercent}}" aria-label="Storage used"></progress>
            <p class="usage-note">Usage relative to {{config.totalStorageGb}}GB limit</p>
        </section>

        <section class="panel stat-card" aria-labelledby="types-title">
            <h2 id="types-title" class="stat-title">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="12" y1="18" x2="12" y2="12"></line>
                    <line x1="9" y1="15" x2="15" y2="15"></line>
                </svg>
                File Types
            </h2>
            <ul class="list-clean">
                {{#each stats.fileTypes}}
                <li class="list-item-row">
                    <span class="file-type">{{@key}}</span>
                    <span class="badge">{{this}}</span>
                </li>
                {{/each}}
            </ul>
        </section>

        <section class="panel stat-card" aria-labelledby="quotas-title">
            <h2 id="quotas-title" class="stat-title">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
                User Quotas
            </h2>
            <ul class="list-clean">
                {{#each userUsageMb}}
                <li class="list-item-row">
                    <span class="list-key">{{@key}}</span>
                    <span class="list-value">{{this}} MB</span>
                </li>
                {{/each}}
            </ul>
        </section>

        <section class="panel stat-card" aria-labelledby="backup-title">
            <h2 id="backup-title" class="stat-title">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                System Backup
            </h2>
            <p class="stat-text">Create and download a full backup of all user data.</p>
            <div class="stack">
                <button type="button" class="btn btn-primary btn-block" id="createBackupBtn">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    Create Backup
                </button>
                <a href="/admin/backup/download" class="btn btn-secondary btn-block">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="3" x2="12" y2="15"></line>
                    </svg>
                    Download Latest Backup
                </a>
                <p id="backupToast" class="backup-status" role="status" aria-live="polite"></p>
            </div>
        </section>
    </div>
</div>
<script src="/js/dashboard.js"></script>
{{/main}}
