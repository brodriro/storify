{{#> main}}
<div class="page">
    <header class="page-header">
        <div class="page-heading">
            <h1 class="page-title">{{t "dashboard.title"}}</h1>
            <p class="page-subtitle">{{t "dashboard.subtitle"}}</p>
        </div>
    </header>

    <div class="dashboard-grid">
        <section class="panel usage-panel" aria-labelledby="usage-title">
            <h2 id="usage-title" class="panel-title">{{t "dashboard.usage"}}</h2>
            <dl class="stat-row">
                <div class="stat">
                    <dt class="stat-label">{{t "dashboard.totalSize"}}</dt>
                    <dd class="stat-value">{{totalSizeLabel}}</dd>
                </div>
                <div class="stat">
                    <dt class="stat-label">{{t "dashboard.files"}}</dt>
                    <dd class="stat-value">{{stats.totalFiles}}</dd>
                </div>
                <div class="stat">
                    <dt class="stat-label">{{t "dashboard.free"}}</dt>
                    <dd class="stat-value">{{storage.freeLabel}}</dd>
                </div>
            </dl>
            <div class="storage-meter meter-{{storage.level}}">
                <div class="meter-label">
                    <span>{{#if limitEnforced}}{{t "dashboard.againstLimit"}}{{else}}{{t "dashboard.againstVolume"}}{{/if}}</span>
                    <span class="meter-value">{{storage.percent}} %</span>
                </div>
                <progress class="usage-bar" max="100" value="{{storage.percent}}" aria-label="{{t "browser.storageUsed"}}"></progress>
                <small class="meter-detail">{{t "browser.usedOfFree" used=storage.usedLabel total=storage.totalLabel free=storage.freeLabel}}</small>
            </div>
        </section>

        <section class="panel backup-panel" aria-labelledby="backup-title">
            <h2 id="backup-title" class="panel-title">{{t "dashboard.backup"}}</h2>
            <p class="panel-text">{{t "dashboard.backupText"}}</p>
            <div class="panel-actions">
                <button type="button" class="btn btn-primary" id="createBackupBtn" {{#if backupRunning}}disabled data-running{{/if}}>
                    <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="17 8 12 3 7 8"></polyline>
                        <line x1="12" y1="3" x2="12" y2="15"></line>
                    </svg>
                    {{t "dashboard.createBackup"}}
                </button>
                {{#if backups.length}}
                <a href="/admin/backup/download" class="btn btn-secondary">
                    <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    {{t "dashboard.downloadBackup"}}
                </a>
                {{/if}}
            </div>
            <p id="backupToast" class="backup-status" role="status" aria-live="polite">{{#if backupRunning}}{{t "dashboard.running"}}{{/if}}</p>

            <h3 class="panel-subtitle">{{t "dashboard.history"}}</h3>
            {{#if backups.length}}
            <table class="data-table backup-table">
                <thead>
                    <tr>
                        <th scope="col">{{t "dashboard.date"}}</th>
                        <th scope="col">{{t "dashboard.kind"}}</th>
                        <th scope="col" class="num">{{t "dashboard.size"}}</th>
                        <th scope="col" class="num col-files">{{t "dashboard.count"}}</th>
                        <th scope="col" class="col-download"><span class="visually-hidden">{{t "browser.download"}}</span></th>
                    </tr>
                </thead>
                <tbody>
                    {{#each backups}}
                    <tr>
                        <th scope="row"><time datetime="{{this.createdIso}}">{{this.createdLabel}}</time></th>
                        <td>{{#if this.isFull}}{{t "dashboard.full"}}{{else}}{{t "dashboard.incremental"}}{{/if}}</td>
                        <td class="num">{{this.sizeLabel}}</td>
                        <td class="num col-files">{{this.fileCount}}</td>
                        <td class="col-download">
                            <a class="btn btn-ghost btn-icon btn-sm" href="{{this.downloadUrl}}" aria-label="{{t "dashboard.downloadOne" date=this.createdLabel}}">
                                <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                    <polyline points="7 10 12 15 17 10"></polyline>
                                    <line x1="12" y1="15" x2="12" y2="3"></line>
                                </svg>
                            </a>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
            {{#if backupsHidden}}
            <p class="panel-note">{{t "dashboard.olderBackups" count=backupsHidden}}</p>
            {{/if}}
            {{else}}
            <p class="panel-note">{{t "dashboard.noBackups"}}</p>
            {{/if}}
        </section>

        <section class="panel" aria-labelledby="quotas-title">
            <h2 id="quotas-title" class="panel-title">{{t "dashboard.perUser"}}</h2>
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">{{t "dashboard.folder"}}</th>
                        <th scope="col" class="num">{{t "dashboard.size"}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each userUsage}}
                    <tr>
                        <th scope="row">{{@key}}</th>
                        <td class="num">{{this}}</td>
                    </tr>
                    {{else}}
                    <tr>
                        <td colspan="2" class="text-muted">{{t "dashboard.none"}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </section>

        <section class="panel" aria-labelledby="types-title">
            <h2 id="types-title" class="panel-title">{{t "dashboard.fileTypes"}}</h2>
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">{{t "dashboard.type"}}</th>
                        <th scope="col" class="num">{{t "dashboard.count"}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each stats.fileTypes}}
                    <tr>
                        <th scope="row"><span class="type-tag">{{@key}}</span></th>
                        <td class="num">{{this}}</td>
                    </tr>
                    {{else}}
                    <tr>
                        <td colspan="2" class="text-muted">{{t "dashboard.none"}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </section>
    </div>
</div>
<script src="/js/dashboard.js"></script>
{{/main}}
