{{#> main}}
<div class="page">
    <header class="page-header">
        <div class="page-heading">
            <h1 class="page-title">{{t "dashboard.title"}}</h1>
            <p class="page-subtitle">{{t "dashboard.subtitle"}}</p>
        </div>
    </header>

    <div class="dashboard-grid">
        <section class="panel usage-panel" aria-labelledby="usage-title">
            <h2 id="usage-title" class="panel-title">{{t "dashboard.usage"}}</h2>
            <dl class="stat-row">
                <div class="stat">
                    <dt class="stat-label">{{t "dashboard.totalSize"}}</dt>
                    <dd class="stat-value">{{totalSizeLabel}}</dd>
                </div>
                <div class="stat">
                    <dt class="stat-label">{{t "dashboard.files"}}</dt>
                    <dd class="stat-value">{{stats.totalFiles}}</dd>
                </div>
                <div class="stat">
                    <dt class="stat-label">{{t "dashboard.capacity"}}</dt>
                    <dd class="stat-value">{{t "dashboard.capacityValue" gb=config.totalStorageGb}}</dd>
                </div>
            </dl>
            <div class="storage-meter meter-{{usageLevel}}">
                <div class="meter-label">
                    <span>{{t "browser.storageUsed"}}</span>
                    <span class="meter-value">{{usagePercent}} %</span>
                </div>
                <progress class="usage-bar" max="100" value="{{usagePercent}}" aria-label="{{t "browser.storageUsed"}}"></progress>
                <small class="meter-detail">{{#if limitEnforced}}{{t "dashboard.usageLimit" gb=config.totalStorageGb}}{{else}}{{t "dashboard.usageReference" gb=config.totalStorageGb}}{{/if}}</small>
            </div>
        </section>

        <section class="panel backup-panel" aria-labelledby="backup-title">
            <h2 id="backup-title" class="panel-title">{{t "dashboard.backup"}}</h2>
            <p class="panel-text">{{t "dashboard.backupText"}}</p>
            <div class="panel-actions">
                <button type="button" class="btn btn-primary" id="createBackupBtn">
                    <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="17 8 12 3 7 8"></polyline>
                        <line x1="12" y1="3" x2="12" y2="15"></line>
                    </svg>
                    {{t "dashboard.createBackup"}}
                </button>
                <a href="/admin/backup/download" class="btn btn-secondary">
                    <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    {{t "dashboard.downloadBackup"}}
                </a>
            </div>
            <p id="backupToast" class="backup-status" role="status" aria-live="polite"></p>
        </section>

        <section class="panel" aria-labelledby="quotas-title">
            <h2 id="quotas-title" class="panel-title">{{t "dashboard.perUser"}}</h2>
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">{{t "dashboard.folder"}}</th>
                        <th scope="col" class="num">{{t "dashboard.size"}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each userUsage}}
                    <tr>
                        <th scope="row">{{@key}}</th>
                        <td class="num">{{this}}</td>
                    </tr>
                    {{else}}
                    <tr>
                        <td colspan="2" class="text-muted">{{t "dashboard.none"}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </section>

        <section class="panel" aria-labelledby="types-title">
            <h2 id="types-title" class="panel-title">{{t "dashboard.fileTypes"}}</h2>
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">{{t "dashboard.type"}}</th>
                        <th scope="col" class="num">{{t "dashboard.count"}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each stats.fileTypes}}
                    <tr>
                        <th scope="row"><span class="type-tag">{{@key}}</span></th>
                        <td class="num">{{this}}</td>
                    </tr>
                    {{else}}
                    <tr>
                        <td colspan="2" class="text-muted">{{t "dashboard.none"}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </section>
    </div>
</div>
<script src="/js/dashboard.js"></script>
{{/main}}
