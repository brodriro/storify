<header class="top-bar">
    <a class="brand" href="/">
        <svg class="icon brand-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <rect x="3" y="4" width="18" height="7" rx="1.5"></rect>
            <rect x="3" y="13" width="18" height="7" rx="1.5"></rect>
            <line x1="7" y1="7.5" x2="7.01" y2="7.5"></line>
            <line x1="7" y1="16.5" x2="7.01" y2="16.5"></line>
        </svg>
        <span>{{t "app.brand"}}</span>
    </a>
    <button type="button" id="themeToggle" class="btn btn-ghost btn-sm" aria-pressed="false">
        <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        {{t "header.darkTheme"}}
    </button>
</header>
