PORT=3000
# Required, at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=
# Optional: without it the app runs with AI features (chat agent, classification) disabled
OPENAI_API_KEY=

STORAGE_PATH=./public_storage
TOTAL_STORAGE_GB=10
ADMIN_EMAIL=admin@example.com
# Upload limits (per file, and files per request)
UPLOAD_MAX_FILE_SIZE_MB=2048
UPLOAD_MAX_FILES=10

# ADMIN -> admin, INVITADO -> read-only guest on public/, everyone else -> member
USERS="ALICE,INVITADO,ADMIN"
USER_ALICE=password
USER_INVITADO=guest
USER_ADMIN=securepassword
