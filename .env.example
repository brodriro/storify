PORT=3000
# Required, at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=
# AI assistant (optional). Without OPENAI_API_KEY or LLM_BASE_URL, AI features are disabled.
# Users are told in the chat which provider receives their messages and documents.
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint, e.g. a local Ollama: http://localhost:11434/v1
LLM_BASE_URL=
# Must support tool calling (default: gpt-5-mini)
LLM_MODEL=

STORAGE_PATH=./public_storage
# Storage limit shown on the dashboard. When set, uploads that would exceed it
# are rejected (507); unset = 10 GB for display only.
# TOTAL_STORAGE_GB=10
ADMIN_EMAIL=admin@example.com
# Assistant requests (messages and confirmations) per user per minute
CHAT_MESSAGES_PER_MINUTE=20
# Upload limits (per file, and files per request)
UPLOAD_MAX_FILE_SIZE_MB=2048
UPLOAD_MAX_FILES=10
# Backups: put them on another disk if you can (default: <STORAGE_PATH>/backups)
BACKUP_PATH=
# Full backups to keep (their incrementals are kept with them)
BACKUP_KEEP_FULL=3

# ADMIN -> admin, INVITADO -> read-only guest on public/, everyone else -> member
USERS="ALICE,INVITADO,ADMIN"
# Passwords: prefer bcrypt hashes from `pnpm hash-password` (keep the single
# quotes it prints). Plaintext still works but logs a warning at startup.
USER_ALICE=password
USER_INVITADO=guest
USER_ADMIN=securepassword
