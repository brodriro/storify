PORT=3000
# Required, at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=
# AI assistant (optional). Without OPENAI_API_KEY or LLM_BASE_URL, AI features are disabled.
# Users are told in the chat which provider receives their messages and documents.
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint, e.g. a local Ollama: http://localhost:11434/v1
LLM_BASE_URL=
# Must support tool calling (default: gpt-5-mini)
LLM_MODEL=

STORAGE_PATH=./public_storage
TOTAL_STORAGE_GB=10
ADMIN_EMAIL=admin@example.com
# Upload limits (per file, and files per request)
UPLOAD_MAX_FILE_SIZE_MB=2048
UPLOAD_MAX_FILES=10

# ADMIN -> admin, INVITADO -> read-only guest on public/, everyone else -> member
USERS="ALICE,INVITADO,ADMIN"
USER_ALICE=password
USER_INVITADO=guest
USER_ADMIN=securepassword
