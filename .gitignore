# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# pnpm is the package manager; never commit npm/yarn lockfiles
package-lock.json
yarn.lock

# Python bytecode (agent skill scripts)
__pycache__/
*.pyc

# Build output
dist/
build/

# Environment variables
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# NestJS
.nest/

# Testing
coverage/
# Agent eval reports (pnpm eval:agent)
evals-results/
.nyc_output/

# Temporary files
temp_uploads/
*.tmp

# User storage directories (anchored to the root so src/storage/ stays tracked)
/public_storage/
/storage/

# Logs (anchored to the root so src/agent/logs/ stays tracked)
/logs/
*.log

# Local audit / improvement plan (not versioned)
plan-mejoras/

# Impeccable working files (review captures, decision-page state)
/.impeccable/review/
/.impeccable/questions/
/.impeccable/mocks/
